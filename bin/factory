def msg(key: str, **kw) -> str:
    es, en = MESSAGES[key]
    return (en if LANG == "en" else es).format(**kw)


def set_lang(root: Path) -> None:
    global LANG
    try:
        text = (root / ".factory" / "project.md").read_text(encoding="utf-8")
        m = re.search(r"^language:\s*(\w+)", text, re.M)
        LANG = m.group(1) if m and m.group(1) in ("es", "en") else "es"
    except OSError:
        LANG = "es"


class Error(Exception):
    pass


# --------------------------------------------------------------------------- utilities

def now() -> str:
    return dt.datetime.now().strftime("%Y-%m-%d %H:%M")


def slug(text: str) -> str:
    t = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode()
    t = re.sub(r"[^a-zA-Z0-9]+", "-", t).strip("-").lower()
    return t[:40].strip("-") or "untitled"


def git(*args: str, cwd: Path, check: bool = True) -> str:
    r = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    if check and r.returncode != 0:
        raise Error(msg("git_failed", cmd=" ".join(args), err=r.stderr.strip()))
    return r.stdout.strip() if r.returncode == 0 else ""


def git_ok(*args: str, cwd: Path) -> bool:
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True).returncode == 0


def text_arg(value: str | None) -> str:
    """--text '-' reads from standard input."""
    if value == "-":
        return sys.stdin.read().strip()
    return (value or "").strip()


def project_root() -> Path:
    current = Path.cwd().resolve()
    for d in [current, *current.parents]:
        if (d / ".factory").is_dir():
            set_lang(d)
            return d
    raise Error(msg("no_factory"))


# --------------------------------------------------------------------------- documents

def _parse_value(txt: str):
    txt = txt.strip()
    if txt.startswith("[") and txt.endswith("]"):
        inner = txt[1:-1].strip()
        return [x.strip() for x in inner.split(",") if x.strip()] if inner else []
    if re.fullmatch(r"-?\d+", txt):
        return int(txt)
    if len(txt) >= 2 and txt[0] == txt[-1] and txt[0] in "\"'":
        return txt[1:-1]
    return txt


def _format_value(v) -> str:
    if isinstance(v, list):
        return "[" + ", ".join(str(x) for x in v) + "]"
    if v is None:
        return ""
    return str(v).replace("\n", " ")


def _find_section(body: str, title: str):
    """Return (content_start, end) of section '## title', or None."""
    marks = list(re.finditer(r"^## (.+?)\s*$", body, re.M))
    for i, m in enumerate(marks):
        if m.group(1) == title:
            end = marks[i + 1].start() if i + 1 < len(marks) else len(body)
            return m.end(), end
    return None


def append_to_section(body: str, title: str, text: str) -> str:
    pos = _find_section(body, title)
    if pos:
        start, end = pos
        block = body[start:end].rstrip("\n")
        return body[:start] + block + "\n" + text.rstrip("\n") + "\n\n" + body[end:]
    section = f"## {title}\n{text.rstrip()}\n\n"
    hist = _find_section(body, SEC_HISTORY)
    if hist:
        title_start = body.rfind(f"## {SEC_HISTORY}", 0, hist[0])
        return body[:title_start] + section + body[title_start:]
    return body.rstrip("\n") + "\n\n" + section


def read_section(body: str, title: str) -> str:
    pos = _find_section(body, title)
    return body[pos[0]:pos[1]].strip() if pos else ""


def clear_section(body: str, title: str) -> str:
    pos = _find_section(body, title)
    if not pos:
        return body
    return body[:pos[0]] + "\n\n" + body[pos[1]:]


class Doc:
    def __init__(self, path: Path):
        self.path = path
        text = path.read_text(encoding="utf-8")
        m = re.match(r"^---\n(.*?)\n---\n?(.*)\Z", text, re.S)
        if not m:
            raise Error(msg("no_frontmatter", path=path))
        self.meta: dict = {}
        for line in m.group(1).splitlines():
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            k, sep, v = line.partition(":")
            if sep:
                self.meta[k.strip()] = _parse_value(v)
        self.body = m.group(2)

    def __getitem__(self, k):
        return self.meta.get(k, "")

    @property
    def id(self) -> str:
        return str(self.meta.get("id", ""))

    @property
    def type(self) -> str:
        return str(self.meta.get("type", ""))

    @property
    def free(self) -> bool:
        return self["status"] not in ("in_progress", "waiting_human", "blocked")

    def log(self, text: str) -> None:
        self.body = append_to_section(self.body, SEC_HISTORY, f"- {now()} · {text}")

    def save(self) -> None:
        self.meta["updated"] = now()
        header = "\n".join(f"{k}: {_format_value(v)}" for k, v in self.meta.items())
        self.path.write_text(f"---\n{header}\n---\n{self.body}", encoding="utf-8")


def _new_body(ident: str, title: str, description: str) -> str:
    return (f"\n# {ident} · {title}\n\n## {SEC_DESCRIPTION}\n"
            f"{description or msg('no_description')}\n\n"
            f"## {SEC_PENDING}\n\n## {SEC_RESOLVED}\n\n## {SEC_HISTORY}\n")


def _write_new(path: Path, meta: dict, body: str) -> Doc:
    header = "\n".join(f"{k}: {_format_value(v)}" for k, v in meta.items())
    path.write_text(f"---\n{header}\n---\n{body}", encoding="utf-8")
    d = Doc(path)
    d.log(msg("log_created"))
    d.save()
    return d


def design_doc(root: Path) -> Doc:
    """The design kit element; created on first use (also for older projects)."""
    path = root / ".factory" / "design.md"
    if not path.exists():
        meta = {k: "" for k in FIELDS["design"]}
        meta.update({"id": "design", "type": "design", "title": msg("design_title"),
                     "phase": "pending", "status": "queued", "created": now()})
        return _write_new(path, meta, _new_body("design", msg("design_title"), ""))
    return Doc(path)


def path_of(root: Path, ident: str) -> Path:
    if ident.lower() == "project":
        return root / ".factory" / "project.md"
    if ident.lower() == "design":
        return design_doc(root).path
    folder = "decisions" if ident.upper().startswith("D") else "state"
    hits = sorted((root / ".factory" / folder).glob(f"{ident.upper()}-*.md"))
    if not hits:
        raise Error(msg("not_found", id=ident))
    return hits[0]


def load(root: Path, ident: str) -> Doc:
    return Doc(path_of(root, ident))


def load_all(root: Path) -> list:
    return [Doc(p) for p in sorted((root / ".factory" / "state").glob("*.md"))]


def next_id(root: Path, prefix: str) -> str:
    folder = "decisions" if prefix == "D" else "state"
    nums = []
    for p in (root / ".factory" / folder).glob(f"{prefix}*-*.md"):
        m = re.match(rf"^{prefix}(\d+)-", p.name)
        if m:
            nums.append(int(m.group(1)))
    return f"{prefix}{(max(nums) + 1 if nums else 1):0{WIDTH[prefix]}d}"


def artifacts(root: Path, doc: Doc) -> dict:
    a = root / ".factory" / "artifacts"
    i = doc.id
    if doc.type == "project":
        return {"vision": a / "vision.md", "roadmap": a / "roadmap.md",
                "architecture": a / "architecture.md"}
    if doc.type == "design":
        return {"brand_guide": a / "design" / "brand-guide.md",
                "design_kit": a / "design" / "index.html"}
    if doc.type == "milestone":
        return {"design": a / i / "design.md", "batch": a / i / "batch.md"}
    if doc.type == "feature":
        return {"spec": a / i / "spec.md", "rules": a / i / "business-rules.md",
                "mockup": a / i / "mockup" / "index.html", "design": a / i / "design.md",
                "validation": a / i / "validation.md"}
    if doc.type == "task":
        return {"review": a / i / "review.md"}
    return {}


def project(root: Path) -> Doc:
    return Doc(root / ".factory" / "project.md")


def max_attempts(root: Path) -> int:
    try:
        return int(project(root)["max_attempts"] or 3)
    except ValueError:
        return 3


# --------------------------------------------------------------------------- commands

def cmd_init(a) -> None:
    global LANG
    LANG = a.language if a.language in ("es", "en") else "es"
    root = Path.cwd().resolve()
    fac = root / ".factory"
    if (fac / "project.md").exists():
        print(msg("already", path=fac))
        return
    for sub in ("state", "artifacts", "decisions", "tmp"):
        (fac / sub).mkdir(parents=True, exist_ok=True)

    if not git_ok("rev-parse", "--git-dir", cwd=root):
        git("init", "-b", a.branch or "master", cwd=root)
    has_commits = git_ok("rev-parse", "--verify", "HEAD", cwd=root)
    branch = a.branch or (git("branch", "--show-current", cwd=root, check=False) or "master")

    gi = root / ".gitignore"
    lines = gi.read_text(encoding="utf-8").splitlines() if gi.exists() else []
    if ".factory/" not in lines:
        lines.append(".factory/")
        gi.write_text("\n".join(lines) + "\n", encoding="utf-8")
    if not has_commits:
        git("add", ".gitignore", cwd=root)
        git("commit", "-m", "Initial commit", cwd=root)

    origin = git("remote", "get-url", "origin", cwd=root, check=False)
    remote = "github" if "github.com" in origin else "none"

    (fac / "project.md").write_text((TEMPLATES / "project.md").read_text(encoding="utf-8"),
                                    encoding="utf-8")
    p = project(root)
    p.meta.update({"name": a.name, "main_branch": branch, "remote": remote,
                   "language": LANG, "created": now()})
    p.log(msg("log_init"))
    p.save()
    design_doc(root)
    print(msg("initialized", path=fac, branch=branch, remote=remote, lang=LANG))
    if has_commits:
        print(msg("gitignore"))


def cmd_new(a) -> None:
    root = project_root()
    doc_type = a.type
    ident = next_id(root, PREFIX_BY_TYPE[doc_type])
    meta = {k: "" for k in FIELDS[doc_type]}
    meta.update({"id": ident, "type": doc_type, "title": a.title,
                 "phase": PHASES[doc_type][0], "status": "queued", "created": now()})
    depends = [x.strip().upper() for x in (a.depends or "").split(",") if x.strip()]

    if doc_type == "milestone":
        meta.update({"goal": a.goal or "", "planned": "no"})
    elif doc_type == "feature":
        if not a.milestone:
            raise Error(msg("need_milestone"))
        load(root, a.milestone)
        meta.update({"milestone": a.milestone.upper(), "priority": a.priority or "must",
                     "version": 1, "depends_on": depends})
    else:
        kind = a.kind or "technical"
        parent = (a.parent or "-").upper()
        milestone = ""
        if parent.startswith("F"):
            milestone = load(root, parent)["milestone"]
        elif parent.startswith("M"):
            load(root, parent)
            milestone = parent
        elif kind != "hotfix":
            raise Error(msg("need_parent"))
        meta.update({"kind": kind, "parent": parent, "milestone": milestone,
                     "package": a.package or "", "attempts": 0, "depends_on": depends})

    path = root / ".factory" / "state" / f"{ident}-{slug(a.title)}.md"
    _write_new(path, meta, _new_body(ident, a.title, text_arg(a.text)))
    print(ident)


def _apply_phase(d: Doc, phase: str, status: str | None, reason: str | None) -> None:
    if phase not in PHASES.get(d.type, []):
        raise Error(msg("bad_phase", type=d.type, phase=phase,
                        valid=", ".join(PHASES.get(d.type, []))))
    previous = d["phase"]
    d.meta["phase"] = phase
    terminal = phase in TERMINAL.get(d.type, set())
    d.meta["status"] = "" if terminal else (status or "queued")
    d.meta["reason"] = reason or ""
    if "awaiting" in d.meta:
        d.meta["awaiting"] = ""
    d.log(msg("log_phase", old=previous, new=phase) + (f" ({reason})" if reason else ""))


def cmd_phase(a) -> None:
    root = project_root()
    d = load(root, a.id)
    if a.status and a.status not in STATUSES:
        raise Error(msg("bad_status", status=a.status, valid=", ".join(STATUSES)))
    _apply_phase(d, a.phase, a.status, a.reason)
    d.save()
    print(msg("phase_out", id=d.id, phase=d["phase"], status=d["status"] or "-"))


def cmd_status(a) -> None:
    root = project_root()
    d = load(root, a.id)
    if a.status not in STATUSES:
        raise Error(msg("bad_status", status=a.status, valid=", ".join(STATUSES)))
    d.meta["status"] = a.status
    d.meta["reason"] = a.reason or ""
    d.meta["awaiting"] = a.awaiting if a.status == "waiting_human" and a.awaiting else ""
    d.log(msg("log_status", status=a.status) + (f" ({a.reason})" if a.reason else ""))
    d.save()
    print(f"{d.id}: {d['phase'] or '-'} · {a.status}")


def cmd_set(a) -> None:
    root = project_root()
    d = load(root, a.id)
    for pair in a.pairs:
        k, sep, v = pair.partition("=")
        if not sep:
            raise Error(msg("pair_format", pair=pair))
        if k in ("id", "type"):
            raise Error(msg("field_locked", field=k))
        if k in ("phase", "status"):
            raise Error(msg("use_command", field=k))
        d.meta[k] = _parse_value(v)
        d.log(f"{k} = {v}")
    d.save()
    print(msg("updated", id=d.id))


def cmd_show(a) -> None:
    root = project_root()
    path = path_of(root, a.id)
    print(path.read_text(encoding="utf-8"))
    if not a.id.upper().startswith("D") or a.id.lower() == "design":
        _print_paths(root, Doc(path))


def _print_paths(root: Path, d: Doc) -> None:
    arts = artifacts(root, d)
    if arts:
        print(msg("artifacts"))
        for name, path in arts.items():
            state = msg("exists") if path.exists() else "—"
            print(f"  {name:<13} {path.relative_to(root)}  [{state}]")


def cmd_paths(a) -> None:
    root = project_root()
    _print_paths(root, load(root, a.id))


def _row(d: Doc) -> str:
    extra = []
    if d["agent"]:
        extra.append(d["agent"])
    if d["reason"]:
        extra.append(f"«{d['reason']}»")
    return (f"{d.id:<6} {d['phase']:<12} {d['status'] or '-':<14} {d['title']}"
            + (f"  ({'; '.join(extra)})" if extra else ""))


def cmd_list(a) -> None:
    root = project_root()
    for d in load_all(root):
        if a.type and d.type != a.type:
            continue
        if a.milestone and d["milestone"] != a.milestone.upper() and d.id != a.milestone.upper():
            continue
        if a.phase and d["phase"] != a.phase:
            continue
        if a.status and d["status"] != a.status:
            continue
        print(_row(d))


def cmd_board(a) -> None:
    root = project_root()
    p = project(root)
    design = design_doc(root)
    docs = load_all(root)
    print(msg("board_head", name=p["name"], discovery=p["discovery"],
              architecture=p["architecture"],
              design=f"{design['level'] or '?'}/{design['phase']}", status=p["status"] or "-"))
    for m in (d for d in docs if d.type == "milestone"):
        print(f"\n{_row(m)}")
        for f in (d for d in docs if d.type == "feature" and d["milestone"] == m.id):
            print(f"  {_row(f)}")
            for t in (d for d in docs if d.type == "task" and d["parent"] == f.id):
                print(f"      {_row(t)}")
        cross = [d for d in docs if d.type == "task" and d["parent"] == m.id]
        if cross:
            print("  " + msg("cross_cutting"))
            for t in cross:
                print(f"      {_row(t)}")
    hotfixes = [d for d in docs if d.type == "task" and d["kind"] == "hotfix"]
    if hotfixes:
        print("\nHotfix:")
        for t in hotfixes:
            print(f"  {_row(t)}")


def _attention(root: Path) -> list:
    return [d for d in [project(root), design_doc(root), *load_all(root)]
            if d["status"] in ("waiting_human", "blocked")]


def cmd_attention(a) -> None:
    root = project_root()
    pending = _attention(root)
    if not pending:
        print(msg("nothing_attention"))
    for d in pending:
        print(f"{d.id:<9} {d['status']:<14} {d['title'] or d['name']} "
              f"— {d['reason'] or msg('no_reason')}")
        questions = read_section(d.body, SEC_PENDING)
        if questions:
            print("  " + questions.replace("\n", "\n  "))


def cmd_ask(a) -> None:
    root = project_root()
    d = load(root, a.id)
    text = text_arg(a.text)
    if not text:
        raise Error(msg("missing_questions"))
    d.body = append_to_section(d.body, SEC_PENDING,
                               f"_{now()}{' · ' + a.agent if a.agent else ''}_\n\n{text}")
    d.meta["status"] = "waiting_human"
    d.meta["reason"] = a.reason or msg("default_reason")
    d.meta["awaiting"] = "answer_questions"
    d.log(msg("log_asked", reason=d.meta["reason"]))
    d.save()
    print(f"{d.id}: waiting_human")


def resolve_questions(d: Doc, decision: str) -> None:
    pending = read_section(d.body, SEC_PENDING)
    if pending:
        d.body = clear_section(d.body, SEC_PENDING)
        d.body = append_to_section(d.body, SEC_RESOLVED,
                                   f"**{msg('resolved_in', decision=decision)}**\n\n{pending}")
    d.meta["status"] = "queued"
    d.meta["reason"] = ""
    d.meta["awaiting"] = ""
    d.log(msg("log_resolved", decision=decision))
    d.save()


def cmd_resolve(a) -> None:
    root = project_root()
    d = load(root, a.id)
    resolve_questions(d, a.decision)
    print(f"{d.id}: queued")


def record_decision(root: Path, title: str, ref: str, text: str) -> str:
    ident = next_id(root, "D")
    path = root / ".factory" / "decisions" / f"{ident}-{slug(title)}.md"
    ref = ref or ""
    ref = ref.lower() if ref.lower() in ("project", "design") else ref.upper()
    path.write_text(
        f"---\nid: {ident}\ntitle: {title}\nref: {ref}\ndate: {now()}\n---\n\n"
        f"# {ident} · {title}\n\n{text}\n", encoding="utf-8")
    return ident


def cmd_decision(a) -> None:
    root = project_root()
    text = text_arg(a.text)
    if not text:
        raise Error(msg("missing_decision"))
    print(record_decision(root, a.title, a.ref, text))


def cmd_attempt(a) -> None:
    root = project_root()
    d = load(root, a.id)
    d.meta["attempts"] = int(d["attempts"] or 0) + 1
    limit = max_attempts(root)
    note = msg("attempt", n=d["attempts"], limit=limit) + (f": {a.reason}" if a.reason else "")
    d.log(note)
    if d["attempts"] >= limit:
        d.meta["status"] = "blocked"
        d.meta["reason"] = msg("blocked_reason", limit=limit) + (
            f" ({msg('last', reason=a.reason)})" if a.reason else "")
    d.save()
    print(f"{d.id}: {note}" + (f" → {msg('blocked')}" if d["status"] == "blocked" else ""))


def cmd_open_release(a) -> None:
    root = project_root()
    m = load(root, a.id)
    if m.type != "milestone" or m["phase"] != "approved":
        raise Error(msg("need_approved", id=m.id))
    p = project(root)
    base = p["main_branch"] or "master"
    branch = m["branch"] or f"release/{m.id}-{slug(m['title'])}"
    if p["remote"] == "github":
        git("fetch", "--quiet", "origin", cwd=root, check=False)
        if git_ok("rev-parse", "--verify", f"origin/{base}", cwd=root):
            base = f"origin/{base}"
    if not git_ok("rev-parse", "--verify", branch, cwd=root):
        git("branch", "--no-track", branch, base, cwd=root)
    if p["remote"] == "github":
        git("push", "-u", "origin", branch, cwd=root)
    m.meta["branch"] = branch
    m.log(msg("log_release", branch=branch, base=base))
    m.save()
    print(branch)


def cmd_export(a) -> None:
    root = project_root()
    if not git_ok("rev-parse", "--verify", a.ref, cwd=root):
        raise Error(msg("no_ref", ref=a.ref))
    target = root / ".factory" / "tmp" / slug(a.ref)
    if target.exists():
        shutil.rmtree(target)
    target.mkdir(parents=True)
    archive = subprocess.Popen(["git", "archive", a.ref], cwd=root, stdout=subprocess.PIPE)
    subprocess.run(["tar", "-x", "-C", str(target)], stdin=archive.stdout, check=True)
    archive.wait()
    print(target)


def _pr_merged(pr, root: Path) -> bool:
    r = subprocess.run(["gh", "pr", "view", str(pr), "--json", "state", "-q", ".state"],
                       cwd=root, capture_output=True, text=True)
    return r.returncode == 0 and r.stdout.strip() == "MERGED"


def _branch_merged(branch: str, target: str, root: Path, remote: bool) -> bool:
    if not branch or not target:
        return False
    if remote and git_ok("rev-parse", "--verify", f"origin/{target}", cwd=root):
        target = f"origin/{target}"
    return git_ok("merge-base", "--is-ancestor", branch, target, cwd=root)


def sync(root: Path) -> list:
    """Detect merged PRs/releases; returns the change messages."""
    p = project(root)
    remote = p["remote"] == "github"
    main = p["main_branch"] or "master"
    if remote:
        git("fetch", "--quiet", "--prune", "origin", cwd=root, check=False)
    docs = load_all(root)
    releases = {d.id: d["branch"] for d in docs if d.type == "milestone"}
    changes = []
    for d in docs:
        if d.type == "task" and d["phase"] == "in_review":
            target = main if d["kind"] == "hotfix" else releases.get(d["milestone"], "")
            merged = (_pr_merged(d["pr"], root) if remote and d["pr"]
                      else _branch_merged(d["branch"], target, root, remote))
            if merged:
                _apply_phase(d, "done", None, None)
                d.save()
                changes.append(msg("merged_task", id=d.id))
        elif d.type == "milestone" and d["phase"] == "approved" and d["closing"] == "requested":
            merged = (_pr_merged(d["pr"], root) if remote and d["pr"]
                      else _branch_merged(d["branch"], main, root, remote))
            if merged:
                d.meta["closing"] = "merged"
                _apply_phase(d, "closed", None, None)
                d.save()
                changes.append(msg("merged_release", id=d.id, main=main))
    return changes


def cmd_sync(a) -> None:
    changes = sync(project_root())
    print("\n".join(changes) if changes else msg("no_changes"))


# --------------------------------------------------------------------------- design

def _token_leaves(node: dict, path: list, out: list) -> None:
    for k, v in node.items():
        if k.startswith("$") or not isinstance(v, dict):
            continue
        if "$value" in v:
            out.append((path + [k], v))
        else:
            _token_leaves(v, path + [k], out)


def _css_value(value) -> str:
    if isinstance(value, list):
        return ", ".join(f'"{x}"' if " " in str(x) else str(x) for x in value)
    if isinstance(value, dict):  # shadow object or dimension object
        if "unit" in value:
            return f"{value['value']}{value['unit']}"
        parts = [value.get(k, "0") for k in ("offsetX", "offsetY", "blur", "spread")]
        return " ".join(str(x) for x in parts) + f" {_css_value(value.get('color', ''))}"
    text = str(value)
    return re.sub(r"\{([^}]+)\}", lambda m: f"var(--{m.group(1).replace('.', '-')})", text)


def build_tokens_css(tokens: dict) -> str:
    leaves: list = []
    _token_leaves(tokens, [], leaves)
    light = [f"  --{'-'.join(path)}: {_css_value(t['$value'])};" for path, t in leaves]
    dark = [f"  --{'-'.join(path)}: {_css_value(t['$extensions']['mode']['dark'])};"
            for path, t in leaves
            if isinstance(t.get("$extensions"), dict)
            and isinstance(t["$extensions"].get("mode"), dict)
            and "dark" in t["$extensions"]["mode"]]
    css = ["/* Generated by `factory tokens` from tokens.json. Do not edit by hand. */",
           ":root {", *light, "}"]
    if dark:
        css += ["", "@media (prefers-color-scheme: dark) {",
                '  :root:not([data-theme="light"]) {',
                *["  " + line for line in dark], "  }", "}",
                "", ':root[data-theme="dark"] {', *dark, "}"]
    return "\n".join(css) + "\n"


def cmd_tokens(a) -> None:
    if a.src:
        src = Path(a.src)
        out = Path(a.out) if a.out else src.with_name("tokens.css")
    else:
        src = project_root() / ".factory" / "artifacts" / "design" / "tokens.json"
        out = src.with_name("tokens.css")
    if not src.exists():
        raise Error(msg("no_file", path=src))
    try:
        tokens = json.loads(src.read_text(encoding="utf-8"))
    except ValueError as e:
        raise Error(msg("bad_json", path=src, err=e))
    out.write_text(build_tokens_css(tokens), encoding="utf-8")
    print(out)


def cmd_design_kit(a) -> None:
    target = project_root() / ".factory" / "artifacts" / "design"
    target.mkdir(parents=True, exist_ok=True)
    for name in ("tokens.json", "brand-guide.md", "index.html"):
        dest = target / name
        if name == "index.html" or not dest.exists():  # the gallery is generic: always refresh it
            shutil.copyfile(TEMPLATES / "design" / name, dest)
    (target / "assets").mkdir(exist_ok=True)
    (target / "tokens.css").write_text(
        build_tokens_css(json.loads((target / "tokens.json").read_text(encoding="utf-8"))),
        encoding="utf-8")
    print(target)


# --------------------------------------------------------------------------- conversation

def _append_jsonl(path: Path, record: dict) -> None:
    record = {"time": dt.datetime.now().strftime("%Y-%m-%dT%H:%M:%S"), **record}
    with open(path, "a", encoding="utf-8") as f:
        f.write(json.dumps(record, ensure_ascii=False) + "\n")


def _read_jsonl(path: Path, limit: int) -> list:
    try:
        lines = path.read_text(encoding="utf-8").splitlines()[-limit:]
    except OSError:
        return []
    out = []
    for line in lines:
        try:
            out.append(json.loads(line))
        except ValueError:
            pass
    return out


def cmd_say(a) -> None:
    """The orchestrator writes a short message for the panel's conversation dock."""
    root = project_root()
    text = text_arg(a.text)
    if not text:
        raise Error(msg("missing_say"))
    _append_jsonl(root / ".factory" / "conversation.jsonl", {"from": "orchestrator", "text": text})


# --------------------------------------------------------------------------- routing

def compute_next(root: Path):
    """Return (human, in_progress, actions); actions = [(who, id, mode)].

    who is "orchestrator" or "launch <agent>"; mode is the mode identifier the
    orchestrator or the agent acts on (see docs/state.md).
    """
    p = project(root)
    design = design_doc(root)
    docs = load_all(root)
    milestones = [d for d in docs if d.type == "milestone"]
    features = [d for d in docs if d.type == "feature"]
    tasks = [d for d in docs if d.type == "task"]
    by_id = {d.id: d for d in docs}
    actions: list = []

    def action(who: str, ident: str, mode: str) -> None:
        if (who, ident, mode) not in actions:
            actions.append((who, ident, mode))

    def deps_ok(d: Doc) -> bool:
        return all(by_id.get(x) is not None and by_id[x]["phase"] in ("done", "validated",
                                                                     "accepted")
                   for x in d["depends_on"] or [])

    human = _attention(root)
    in_progress = [d for d in [p, design, *docs] if d["status"] == "in_progress"]

    if p["discovery"] != "done":
        if p.free:
            action("orchestrator", "project", "discovery")
    else:
        # Architecture base and design kit are independent: they may run in parallel.
        if p["architecture"] != "done" and p.free:
            action("launch architect", "project", "base")
        needs_design = p["interface"] in ("web", "mixed")
        if needs_design and design.free and design["phase"] != "approved":
            if not design["level"]:
                action("orchestrator", "design", "choose_design")
            elif design["level"] != "none":
                kit = root / ".factory" / "artifacts" / "design"
                if (kit / "tokens.css").exists() and (kit / "brand-guide.md").exists():
                    action("orchestrator", "design", "approve_design")
                else:
                    action("launch prototyper", "design", "design_system")
        design_ready = (not needs_design or design["level"] == "none"
                        or design["phase"] == "approved")

        if p["architecture"] == "done" and design_ready:
            active = next((m for m in milestones if m["phase"] == "approved"), None)
            if active is None:
                proposed = next((m for m in milestones if m["phase"] == "proposed"), None)
                if proposed and proposed.free:
                    first = not any(m["phase"] == "closed" for m in milestones)
                    action("orchestrator", proposed.id,
                           "approve_milestone_first" if first else "approve_milestone")
                elif not proposed:
                    action("orchestrator", "project", "roadmap_review")
            else:
                _milestone_actions(root, active, features, tasks, deps_ok, action)

    # hotfix: outside the milestone flow
    _task_actions([t for t in tasks if t["kind"] == "hotfix"], tasks, deps_ok, action)
    return human, in_progress, actions


def _milestone_actions(root, m, features, tasks, deps_ok, action) -> None:
    if not m["branch"]:
        action("orchestrator", m.id, "open_release")
        return
    if m["planned"] != "yes":
        if m.free:
            action("launch architect", m.id, "milestone")
        return

    fs = [f for f in features if f["milestone"] == m.id]
    for f in fs:
        if not f.free:
            continue
        arts = artifacts(root, f)
        phase = f["phase"]
        if phase == "defined":
            if not arts["spec"].exists():
                action("launch analyst", f.id, "specify")
            elif f["needs_mockup"] == "yes" and not arts["mockup"].exists():
                action("launch prototyper", f.id, "mockup")
            else:
                action("orchestrator", f.id, "approve_spec")
        elif phase == "specified":
            action("launch architect", f.id, "feature")
        elif phase == "building":
            own = [t for t in tasks if t["parent"] == f.id and t["phase"] != "discarded"]
            open_ = [t for t in own if t["phase"] != "done"]
            if f["validation"] in ("ko", "rejected"):
                if not open_:
                    action("launch architect", f.id, "fix")
            elif own and not open_:
                action("launch validator", f.id, "feature_validation")

    in_milestone = [t for t in tasks if t["milestone"] == m.id and t["kind"] != "hotfix"]
    _task_actions(in_milestone, tasks, deps_ok, action)

    alive = [f for f in fs if f["phase"] not in ("postponed", "discarded")]
    tasks_done = all(t["phase"] in ("done", "discarded") for t in in_milestone)
    if not tasks_done or not m.free:
        return
    if alive and all(f["phase"] in ("validated", "accepted") for f in alive) \
            and any(f["phase"] == "validated" for f in alive):
        action("orchestrator", m.id, "present_batch")
    elif all(f["phase"] == "accepted" for f in alive) and (alive or in_milestone) \
            and m["closing"] != "requested":
        action("orchestrator", m.id, "close_milestone")


def _task_actions(candidates, tasks, deps_ok, action) -> None:
    developer_busy = any(t["phase"] == "development" and t["status"] == "in_progress"
                         for t in tasks)
    ordered = sorted(candidates, key=lambda t: (t["kind"] != "hotfix",
                                                t["kind"] != "cross_cutting", t.id))
    for t in ordered:
        if not t.free:
            continue
        if t["phase"] in ("pending", "development") and not developer_busy and deps_ok(t):
            group = [t.id]
            if t["package"] and t["phase"] == "pending":
                group = [x.id for x in ordered if x["package"] == t["package"]
                         and x["milestone"] == t["milestone"] and x["phase"] == "pending"
                         and x.free]
            if t["kind"] == "hotfix":
                mode = "hotfix"
            else:
                mode = "resume" if t["phase"] == "development" else "implement"
            action("launch developer", ",".join(group), mode)
            developer_busy = True
        elif t["phase"] == "in_review":
            if t["review"] == "ok":
                action("orchestrator", t.id, "approve_merge")
            else:
                action("launch validator", t.id, "task_review")


def read_activity(root: Path) -> dict:
    """Agents currently working (from the activity hook), with idle time."""
    try:
        act = json.loads((root / ".factory" / "activity.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        act = {}
    current = dt.datetime.now()
    agents = []
    for agent_id, a in (act.get("agents") or {}).items():
        try:
            idle = int((current - dt.datetime.fromisoformat(a.get("last_seen", ""))).total_seconds())
        except ValueError:
            idle = 0
        agents.append({**a, "id": agent_id, "idle_seconds": idle,
                       "stale": idle > STALE_SECONDS})
    agents.sort(key=lambda a: a.get("started", ""))
    return {"agents": agents, "recent": act.get("recent") or []}


def cmd_next(a) -> None:
    root = project_root()
    human, in_progress, actions = compute_next(root)
    working = read_activity(root)["agents"]
    if human:
        print(msg("next_human"))
        for d in human:
            print(f"  {d.id:<9} {d['status']:<14} {d['reason'] or '-'}")
    if working or in_progress:
        print(msg("next_working"))
        for ag in working:
            print(f"  {ag['role']:<13} {','.join(ag.get('items') or []) or '-'}"
                  + ("  (stale)" if ag["stale"] else ""))
        listed = {i for ag in working for i in ag.get("items") or []}
        for d in in_progress:
            if d.id not in listed:
                print(f"  {'?':<13} {d.id}  {d['title'] or ''}")
    print(msg("next_actions"))
    if actions:
        for who, ident, mode in actions:
            print(f"  {who:<20} {ident:<9} {mode}")
    else:
        print("  " + msg("next_none"))


# --------------------------------------------------------------------------- panel

def _prs_url(root: Path) -> str:
    origin = git("remote", "get-url", "origin", cwd=root, check=False)
    m = re.search(r"github\.com[:/]([^/]+/[^/]+?)(?:\.git)?$", origin)
    return f"https://github.com/{m.group(1)}/pull/" if m else ""


def state_json(root: Path) -> dict:
    art_base = root / ".factory" / "artifacts"

    def serialize(d: Doc) -> dict:
        arts = {k: str(v.relative_to(art_base)) for k, v in artifacts(root, d).items()
                if v.exists()}
        data = {"meta": d.meta, "body": d.body, "artifacts": arts}
        if d.type == "feature" and "spec" in arts:
            text = (art_base / arts["spec"]).read_text(encoding="utf-8")
            data["criteria"] = len(set(re.findall(r"AC-F\d+-\d+", text)))
        return data

    decisions = []
    for path in sorted((root / ".factory" / "decisions").glob("D*.md")):
        try:
            d = Doc(path)
            decisions.append({"meta": d.meta, "body": d.body})
        except Error:
            pass
    human, in_progress, actions = compute_next(root)
    return {
        "project": serialize(project(root)),
        "design": serialize(design_doc(root)),
        "items": [serialize(d) for d in load_all(root)],
        "decisions": decisions,
        "actions": [{"who": w, "id": i, "mode": m} for w, i, m in actions],
        "activity": read_activity(root),
        "conversation": _read_jsonl(root / ".factory" / "conversation.jsonl", 200),
        "language": LANG,
        "max_attempts": max_attempts(root),
        "prs_url": _prs_url(root),
        "generated": now(),
    }


def apply_panel_action(root: Path, data: dict) -> str:
    """Apply a decision taken in the panel; returns the summary for the orchestrator."""
    ident, action = str(data["id"]), str(data["action"])
    comment, choice = str(data.get("comment") or "").strip(), str(data.get("choice") or "").strip()
    d = load(root, ident)
    awaiting = d["awaiting"]
    what_key = {"approve_spec": "w_approve_spec", "approve_design": "w_approve_design",
                "approve_milestone": "w_approve_milestone"}.get(awaiting)
    what = msg(what_key) if what_key else awaiting
    bad = Error(msg("bad_action", action=action, id=ident, awaiting=awaiting or "-"))

    def decide(title_key: str, extra: str = "") -> str:
        text = msg("dec_from_panel") + (f"\n\n{extra}" if extra else "")
        return record_decision(root, msg("dec_title", what=msg(title_key), id=d.id), d.id, text)

    if action == "approve":
        target = {"approve_spec": "specified", "approve_design": "approved",
                  "approve_milestone": "approved"}.get(awaiting)
        if not target:
            raise bad
        dec = decide(what_key)
        _apply_phase(d, target, None, None)
        d.save()
        return msg("in_approve", id=d.id, what=what, dec=dec)
    if action == "request_changes":
        if not awaiting:
            raise bad
        dec = decide("w_changes", comment)
        d.meta.update({"status": "queued", "reason": msg("changes_reason", dec=dec), "awaiting": ""})
        d.log(msg("changes_reason", dec=dec))
        d.save()
        return msg("in_changes", id=d.id, what=what, comment=comment, dec=dec)
    if action in ("postpone", "discard"):
        if d.type != "feature":
            raise bad
        phase = "postponed" if action == "postpone" else "discarded"
        dec = decide("w_postpone" if action == "postpone" else "w_discard", comment)
        _apply_phase(d, phase, None, None)
        d.save()
        return msg("in_phase", id=d.id, phase=phase, dec=dec)
    if action == "merged":
        if awaiting not in ("approve_merge", "close_milestone"):
            raise bad
        changes = sync(root)
        return msg("in_merged", id=d.id, changes="; ".join(changes) or msg("in_not_merged"))
    if action == "answer":
        if awaiting != "answer_questions" or not choice:
            raise bad
        questions = read_section(d.body, SEC_PENDING)
        dec = decide("w_answers", f"{questions}\n\n**→ {choice}**")
        resolve_questions(d, dec)
        return msg("in_answers", id=d.id, choice=choice, dec=dec)
    if action == "accept_all":
        if awaiting != "present_batch" or d.type != "milestone":
            raise bad
        accepted = []
        for f in load_all(root):
            if f.type == "feature" and f["milestone"] == d.id and f["phase"] == "validated":
                _apply_phase(f, "accepted", None, None)
                f.save()
                accepted.append(f.id)
        dec = decide("w_batch", ", ".join(accepted))
        d.meta.update({"status": "queued", "reason": "", "awaiting": ""})
        d.save()
        return msg("in_batch", id=d.id, features=", ".join(accepted) or "-", dec=dec)
    if action == "review_one":
        return msg("in_review_one", id=d.id)
    raise bad


def _handler(root: Path):
    art_base = (root / ".factory" / "artifacts").resolve()

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *args):  # keep the terminal quiet
            pass

        def _send(self, code: int, body: bytes, content_type: str) -> None:
            self.send_response(code)
            self.send_header("Content-Type", content_type)
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            route = unquote(urlparse(self.path).path)
            not_found = msg("not_found_http").encode("utf-8")
            try:
                if route in ("/", "/index.html"):
                    html = (PLUGIN_ROOT / "panel" / "index.html").read_bytes()
                    self._send(200, html, "text/html; charset=utf-8")
                elif route == "/api/state":
                    set_lang(root)  # the language may change while the panel runs
                    data = json.dumps(state_json(root), ensure_ascii=False, default=str)
                    self._send(200, data.encode("utf-8"), "application/json; charset=utf-8")
                elif route.startswith("/artifact/"):
                    target = (art_base / route[len("/artifact/"):]).resolve()
                    if art_base not in target.parents or not target.is_file():
                        self._send(404, not_found, "text/plain; charset=utf-8")
                        return
                    ctype = mimetypes.guess_type(target.name)[0] or "application/octet-stream"
                    if target.suffix == ".md":
                        ctype = "text/plain"
                    if ctype.startswith("text/"):
                        ctype += "; charset=utf-8"
                    self._send(200, target.read_bytes(), ctype)
                else:
                    self._send(404, not_found, "text/plain; charset=utf-8")
            except Exception as e:  # a half-written file must not bring the panel down
                self._send(500, str(e).encode("utf-8"), "text/plain; charset=utf-8")

        def do_POST(self):
            # A custom header forces a CORS preflight, so other web pages cannot post here.
            if self.headers.get("X-Factory") != "1":
                self._send(403, b"forbidden", "text/plain; charset=utf-8")
                return
            try:
                length = int(self.headers.get("Content-Length") or 0)
                data = json.loads(self.rfile.read(length) or b"{}")
            except ValueError:
                self._send(400, b"bad request", "text/plain; charset=utf-8")
                return
            set_lang(root)
            fac = root / ".factory"
            route = urlparse(self.path).path
            if route == "/api/message" and str(data.get("text", "")).strip():
                text = str(data["text"]).strip()
                _append_jsonl(fac / "inbox.jsonl", {"type": "message", "text": text,
                                                    "summary": msg("in_message", text=text)})
                _append_jsonl(fac / "conversation.jsonl", {"from": "user", "text": text})
            elif route == "/api/action" and data.get("id") and data.get("action"):
                try:
                    summary = apply_panel_action(root, data)
                except Error as e:
                    self._send(409, str(e).encode("utf-8"), "text/plain; charset=utf-8")
                    return
                record = {k: str(data[k]) for k in ("id", "action", "choice", "comment") if data.get(k)}
                _append_jsonl(fac / "inbox.jsonl", {"type": "action", "summary": summary, **record})
                event = msg("ev_action", action=data.get("label") or data["action"], id=data["id"])
                if data.get("comment"):
                    event += f" — «{data['comment']}»"
                _append_jsonl(fac / "conversation.jsonl", {"from": "event", "text": event})
            else:
                self._send(400, b"bad request", "text/plain; charset=utf-8")
                return
            self._send(200, b"ok", "text/plain; charset=utf-8")

    return Handler


def cmd_panel(a) -> None:
    root = project_root()
    server = None
    for port in range(a.port, a.port + 20):
        try:
            server = ThreadingHTTPServer(("127.0.0.1", port), _handler(root))
            break
        except OSError:
            continue
    if server is None:
        raise Error(msg("no_ports", a=a.port, b=a.port + 19))
    url = f"http://127.0.0.1:{server.server_address[1]}/"
    (root / ".factory" / "panel.url").write_text(url + "\n", encoding="utf-8")
    print(msg("panel", name=project(root)["name"], url=url), flush=True)
    if a.open:
        webbrowser.open(url)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        (root / ".factory" / "panel.url").unlink(missing_ok=True)


# --------------------------------------------------------------------------- CLI

def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="factory", description="factory state layer")
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("init", help="create .factory/ in the current folder")
    s.add_argument("--name", required=True)
    s.add_argument("--branch", help="main branch (default: current branch or master)")
    s.add_argument("--language", default="es",
                   help="language of everything the human reads: es | en (default es)")
    s.set_defaults(f=cmd_init)

    s = sub.add_parser("new", help="create a milestone, feature or task; prints its ID")
    s.add_argument("type", choices=["milestone", "feature", "task"])
    s.add_argument("--title", required=True)
    s.add_argument("--text", help="description; '-' reads stdin")
    s.add_argument("--goal")
    s.add_argument("--milestone")
    s.add_argument("--priority", choices=PRIORITIES)
    s.add_argument("--parent")
    s.add_argument("--kind", choices=KINDS)
    s.add_argument("--package")
    s.add_argument("--depends", help="comma-separated IDs")
    s.set_defaults(f=cmd_new)

    s = sub.add_parser("phase", help="change the phase (status becomes queued by default)")
    s.add_argument("id")
    s.add_argument("phase")
    s.add_argument("--status")
    s.add_argument("--reason")
    s.set_defaults(f=cmd_phase)

    s = sub.add_parser("status", help="change the status")
    s.add_argument("id")
    s.add_argument("status")
    s.add_argument("--reason")
    s.add_argument("--awaiting", help="with waiting_human: what is awaited (approve_spec, approve_design, "
                                      "approve_milestone, approve_merge, present_batch, close_milestone…)")
    s.set_defaults(f=cmd_status)

    s = sub.add_parser("set", help="change fields: factory set ID field=value ...")
    s.add_argument("id")
    s.add_argument("pairs", nargs="+")
    s.set_defaults(f=cmd_set)

    for name, fn, help_ in (("show", cmd_show, "show an item and its artifacts"),
                            ("paths", cmd_paths, "artifact paths of an item")):
        s = sub.add_parser(name, help=help_)
        s.add_argument("id")
        s.set_defaults(f=fn)

    s = sub.add_parser("list", help="list items with filters")
    s.add_argument("--type", choices=["milestone", "feature", "task"])
    s.add_argument("--milestone")
    s.add_argument("--phase")
    s.add_argument("--status")
    s.set_defaults(f=cmd_list)

    sub.add_parser("board", help="progress: milestones → features → tasks") \
        .set_defaults(f=cmd_board)
    sub.add_parser("attention", help="what waits for the human or is blocked") \
        .set_defaults(f=cmd_attention)
    sub.add_parser("next", help="what to do now (orchestrator routing)") \
        .set_defaults(f=cmd_next)
    sub.add_parser("sync", help="detect merged PRs/releases and update state") \
        .set_defaults(f=cmd_sync)

    s = sub.add_parser("ask", help="leave questions for the human; status waiting_human")
    s.add_argument("id")
    s.add_argument("--text", required=True, help="'-' reads stdin")
    s.add_argument("--reason")
    s.add_argument("--agent")
    s.set_defaults(f=cmd_ask)

    s = sub.add_parser("resolve", help="mark the pending questions as resolved by a decision")
    s.add_argument("id")
    s.add_argument("--decision", required=True)
    s.set_defaults(f=cmd_resolve)

    s = sub.add_parser("decision", help="record a decision; prints its ID")
    s.add_argument("--title", required=True)
    s.add_argument("--ref")
    s.add_argument("--text", required=True, help="'-' reads stdin")
    s.set_defaults(f=cmd_decision)

    s = sub.add_parser("attempt", help="count a failed attempt; blocks at the maximum")
    s.add_argument("id")
    s.add_argument("--reason")
    s.set_defaults(f=cmd_attempt)

    s = sub.add_parser("open-release", help="create the release branch of an approved milestone")
    s.add_argument("id")
    s.set_defaults(f=cmd_open_release)

    s = sub.add_parser("export", help="export a branch to .factory/tmp/ to read or run it")
    s.add_argument("ref")
    s.set_defaults(f=cmd_export)

    s = sub.add_parser("design-kit", help="create .factory/artifacts/design/ from the kit template")
    s.set_defaults(f=cmd_design_kit)

    s = sub.add_parser("tokens", help="generate tokens.css from tokens.json")
    s.add_argument("--src", help="source tokens.json (default: the project's kit)")
    s.add_argument("--out", help="target tokens.css (default: next to the source)")
    s.set_defaults(f=cmd_tokens)

    s = sub.add_parser("say", help="write a message for the panel's conversation dock")
    s.add_argument("--text", required=True, help="'-' reads stdin")
    s.set_defaults(f=cmd_say)

    s = sub.add_parser("panel", help="serve the HTML control panel on localhost")
    s.add_argument("--port", type=int, default=8765)
    s.add_argument("--open", action="store_true", help="open the browser")
    s.set_defaults(f=cmd_panel)

    a = ap.parse_args(argv)
    try:
        a.f(a)
    except Error as e:
        print(f"factory: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
