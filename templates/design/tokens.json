{
  "$description": "Design tokens del proyecto (formato W3C Design Tokens). Fuente única de verdad: tokens.css se genera con `factory tokens`. Los nombres de los tokens semánticos (color.bg, color.primary, font.family.body…) son un contrato: la galería y las maquetas dependen de ellos. Cambia los valores, no los nombres.",
  "color": {
    "palette": {
      "$description": "Colores de marca en bruto. Los semánticos los referencian.",
      "brand-700": { "$type": "color", "$value": "#173a5c", "$description": "Azul marca oscuro", "$extensions": { "pantone": "PANTONE 534 C (aprox.)", "cmyk": "100 75 25 30" } },
      "brand-500": { "$type": "color", "$value": "#1f5f99", "$description": "Azul marca", "$extensions": { "pantone": "PANTONE 7686 C (aprox.)", "cmyk": "95 60 5 5" } },
      "brand-100": { "$type": "color", "$value": "#e3eef9", "$description": "Azul marca muy claro", "$extensions": { "pantone": "PANTONE 656 C (aprox.)", "cmyk": "10 3 0 0" } },
      "accent-500": { "$type": "color", "$value": "#e8792b", "$description": "Naranja de acento", "$extensions": { "pantone": "PANTONE 158 C (aprox.)", "cmyk": "0 60 90 0" } },
      "neutral-900": { "$type": "color", "$value": "#1b1f24", "$description": "Casi negro" },
      "neutral-600": { "$type": "color", "$value": "#5b636e", "$description": "Gris texto secundario" },
      "neutral-200": { "$type": "color", "$value": "#e1e5ea", "$description": "Gris bordes" },
      "neutral-50": { "$type": "color", "$value": "#f6f7f9", "$description": "Gris fondo" },
      "white": { "$type": "color", "$value": "#ffffff" },
      "green-600": { "$type": "color", "$value": "#1e7a46" },
      "amber-600": { "$type": "color", "$value": "#a85b00" },
      "red-600": { "$type": "color", "$value": "#b42318" }
    },
    "bg": { "$type": "color", "$value": "{color.palette.neutral-50}", "$description": "Fondo de página", "$extensions": { "mode": { "dark": "#0f1318" } } },
    "surface": { "$type": "color", "$value": "{color.palette.white}", "$description": "Tarjetas y paneles", "$extensions": { "mode": { "dark": "#181d24" } } },
    "text": { "$type": "color", "$value": "{color.palette.neutral-900}", "$description": "Texto principal", "$extensions": { "mode": { "dark": "#eef1f5" } } },
    "text-muted": { "$type": "color", "$value": "{color.palette.neutral-600}", "$description": "Texto secundario", "$extensions": { "mode": { "dark": "#a3acb8" } } },
    "border": { "$type": "color", "$value": "{color.palette.neutral-200}", "$description": "Bordes y separadores", "$extensions": { "mode": { "dark": "#2a313b" } } },
    "primary": { "$type": "color", "$value": "{color.palette.brand-500}", "$description": "Acción principal, enlaces", "$extensions": { "mode": { "dark": "#6aa8e6" } } },
    "primary-strong": { "$type": "color", "$value": "{color.palette.brand-700}", "$description": "Hover y énfasis de la acción principal", "$extensions": { "mode": { "dark": "#9cc6f0" } } },
    "primary-soft": { "$type": "color", "$value": "{color.palette.brand-100}", "$description": "Fondos suaves de marca", "$extensions": { "mode": { "dark": "#16304a" } } },
    "on-primary": { "$type": "color", "$value": "{color.palette.white}", "$description": "Texto sobre primary", "$extensions": { "mode": { "dark": "#0b1a29" } } },
    "accent": { "$type": "color", "$value": "{color.palette.accent-500}", "$description": "Llamadas a la acción destacadas (con moderación)" },
    "success": { "$type": "color", "$value": "{color.palette.green-600}", "$description": "Confirmaciones" },
    "warning": { "$type": "color", "$value": "{color.palette.amber-600}", "$description": "Avisos" },
    "danger": { "$type": "color", "$value": "{color.palette.red-600}", "$description": "Errores y acciones destructivas" }
  },
  "font": {
    "family": {
      "heading": { "$type": "fontFamily", "$value": ["Poppins", "system-ui", "sans-serif"], "$extensions": { "url": "https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&display=swap", "license": "SIL Open Font License" } },
      "body": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"], "$extensions": { "url": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap", "license": "SIL Open Font License" } }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "$description": "Escala tipográfica (base 16px, ratio 1.25).",
      "xs": { "$type": "dimension", "$value": "0.8rem" },
      "sm": { "$type": "dimension", "$value": "0.875rem" },
      "md": { "$type": "dimension", "$value": "1rem" },
      "lg": { "$type": "dimension", "$value": "1.25rem" },
      "xl": { "$type": "dimension", "$value": "1.563rem" },
      "2xl": { "$type": "dimension", "$value": "1.953rem" },
      "3xl": { "$type": "dimension", "$value": "2.441rem" },
      "4xl": { "$type": "dimension", "$value": "3.052rem" }
    },
    "line-height": {
      "tight": { "$type": "number", "$value": 1.2 },
      "normal": { "$type": "number", "$value": 1.55 }
    }
  },
  "space": {
    "$description": "Escala de espaciado (base 4px).",
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": "0 1px 2px rgba(16, 24, 40, 0.08)" },
    "md": { "$type": "shadow", "$value": "0 4px 12px rgba(16, 24, 40, 0.12)" }
  },
  "breakpoint": {
    "$description": "Anchos de ruptura (mobile first).",
    "sm": { "$type": "dimension", "$value": "640px" },
    "md": { "$type": "dimension", "$value": "768px" },
    "lg": { "$type": "dimension", "$value": "1024px" },
    "xl": { "$type": "dimension", "$value": "1280px" }
  },
  "layout": {
    "max-width": { "$type": "dimension", "$value": "1200px", "$description": "Ancho máximo del contenido" },
    "gutter": { "$type": "dimension", "$value": "16px", "$description": "Margen lateral en móvil" }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "120ms" },
    "normal": { "$type": "duration", "$value": "200ms" }
  }
}
